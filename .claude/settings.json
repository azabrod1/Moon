{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "additionalDirectories": [
      "/tmp",
      "/private/tmp"
    ],
    "allow": [
      "Bash(npm ci)",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm test)",
      "Bash(npx tsc)",
      "Bash(npx vitest run --dir src)",
      "WebSearch",
      "WebFetch(domain:github.com)"
    ]
  }
}
